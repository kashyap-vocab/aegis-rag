{
 "title": "Aegis RAG",
 "uid": "aegis",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Requests by outcome / refusal layer",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (outcome, reason) (rate(aegis_requests_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Refusal rate",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(aegis_requests_total{outcome=\"refused\"}[15m])) / sum(rate(aegis_requests_total[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "title": "p95 latency by stage (s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(aegis_stage_latency_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "Gate score distribution",
   "type": "heatmap",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (le) (rate(aegis_gate_top_rerank_score_bucket[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "Grounding / quote-check blocks",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "expr": "sum by (layer) (increase(aegis_grounding_failures_total[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "LLM up / fallbacks",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "expr": "aegis_llm_up",
     "refId": "A"
    }
   ]
  }
 ]
}